# Solana RPC endpoints for live data (Phase A).
#
# Without these, the app uses a no-key public endpoint (https://solana-rpc.publicnode.com)
# that allows browser requests. That's fine for local dev and light demo traffic, but it's
# rate-limited and its WebSocket may be unavailable (the app then HTTP-polls the slot). Use a
# free provider key for any real deployment. Get one at https://helius.dev or https://alchemy.com.
#
# Copy this file to .env.local (gitignored) and fill in your key:

# HTTP JSON-RPC endpoint
VITE_SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# WebSocket endpoint (optional — defaults to the ws:// form of the HTTP URL above)
VITE_SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Force a data source: 'live' (default) or 'mock'. The ?mock / ?live URL params override this.
# VITE_DATA_SOURCE=live
